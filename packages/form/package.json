{
  "name": "@xto/form",
  "version": "1.8.3",
  "description": "Xto Form - Form components",
  "homepage": "https://jinguchu.github.io/xto-ui/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jinguchu/xto-ui.git",
    "directory": "packages/form"
  },
  "main": "./lib/index.cjs",
  "module": "./es/index.mjs",
  "types": "./es/index.d.ts",
  "exports": {
    ".": {
      "import": "./es/index.mjs",
      "require": "./lib/index.cjs",
      "types": "./es/index.d.ts"
    }
  },
  "files": [
    "es",
    "lib"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "@xto/core": "^1.7.0",
    "@xto/base": "^1.8.0",
    "@wangeditor/editor": "^5.1.23",
    "@wangeditor/editor-for-vue": "^5.1.12"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.4",
    "@vitejs/plugin-vue-jsx": "^3.1.0",
    "@xto/build": "workspace:*",
    "typescript": "^5.4.2",
    "vite": "^5.2.0",
    "vitest": "^1.4.0",
    "vue": "^3.4.21",
    "happy-dom": "^20.11.6"
  }
}
